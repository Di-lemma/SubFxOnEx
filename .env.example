ZAI_API_KEY=
ZAI_MODEL=glm-5.3
ZAI_THINKING=enabled
ZAI_REASONING_EFFORT=low

MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=tripindex
MONGO_SOURCE_COLLECTION=erowid-clean
MONGO_TARGET_COLLECTION=erowid-effects-1

BATCH_SIZE=10
SOURCE_SCAN_BATCH_SIZE=50
DRY_RUN=false
INTER_DOCUMENT_DELAY_SECONDS=0.5

MAX_COMPLETION_TOKENS=12000
MAX_TAGS_PER_PAYLOAD=40
MAX_REPORT_TEXT_CHARS=4000
REPORT_CHUNK_SIZE_CHARS=4000
REPORT_CHUNK_OVERLAP_CHARS=600
MIN_RETRY_CHUNK_SIZE_CHARS=1200
MAX_TEXT_DETAIL_CHARS=180
MAX_ATTRIBUTION_NOTE_CHARS=180
MIN_TAG_CONFIDENCE=0
REQUIRE_GROUNDED_EVIDENCE=true
ENABLE_SEMANTIC_GUARDS=true
ALLOW_BROAD_FALLBACK_EFFECTS=false

API_MAX_RETRIES=5
API_RETRY_BASE_SECONDS=2
API_RETRY_MAX_SECONDS=60
API_TIMEOUT_SECONDS=300

ERROR_MAX_ATTEMPTS=8
ERROR_RETRY_BASE_SECONDS=300
ERROR_RETRY_MAX_SECONDS=21600
PROCESSING_LEASE_SECONDS=14400

# Existing complete results remain untouched unless this is changed deliberately.
STALE_POLICY=none
REPROCESS_UNVERSIONED=false
